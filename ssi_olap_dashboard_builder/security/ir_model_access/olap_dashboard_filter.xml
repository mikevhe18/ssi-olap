<odoo>

    <record id="olap_dashboard_filter_all_access" model="ir.model.access">
        <field name="name">olap_dashboard_filter - all</field>
        <field name="model_id" ref="model_olap_dashboard_filter" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="0" />
        <field name="perm_create" eval="0" />
        <field name="perm_unlink" eval="0" />
    </record>

    <record id="olap_dashboard_filter_user_access" model="ir.model.access">
        <field name="name">olap_dashboard_filter - user</field>
        <field name="model_id" ref="model_olap_dashboard_filter" />
        <field name="group_id" ref="olap_dashboard_group" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>

</odoo>
