<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_olap_dashboard_form" model="ir.ui.view">
        <field name="name">olap.dashboard.form</field>
        <field name="model">olap.dashboard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate" type="object" string="Validate &amp; Preview"
                            class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_publish" type="object" string="Publish to Dashboard"
                            class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'validated')]}"/>
                    <button name="action_update" type="object" string="Update"
                            class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'published')]}"/>
                    <button name="action_unpublish" type="object" string="Unpublish"
                            confirm="Yakin ingin unpublish? Report akan hilang dari sidebar dashboard."
                            attrs="{'invisible': [('state', '!=', 'published')]}"/>
                    <button name="action_open_dashboard" type="object" string="Open Dashboard"
                            attrs="{'invisible': [('state', '!=', 'published')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validated,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nama Dashboard"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="chart_type"/>
                            <field name="sort_order"/>
                        </group>
                        <group>
                            <field name="go_report_id" readonly="1"
                                   attrs="{'invisible': [('go_report_id', '=', False)]}"/>
                            <field name="created_by" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Query">
                            <field name="description" placeholder="Deskripsi singkat (opsional)"/>
                            <field name="ch_query" widget="text"
                                   placeholder="SELECT ... FROM odoo_analytics.xxx"/>
                        </page>
                        <page string="Konfigurasi Chart"
                              attrs="{'invisible': [('chart_type', '=', 'table')]}">
                            <group>
                                <group attrs="{'invisible': [('chart_type', '=', 'kpi')]}">
                                    <field name="x_axis"/>
                                    <field name="x_label"/>
                                </group>
                                <group>
                                    <field name="y_axis"/>
                                    <field name="y_label"/>
                                </group>
                            </group>
                        </page>
                        <page string="Preview"
                              attrs="{'invisible': [('preview_data', '=', False)]}">
                            <field name="preview_columns" invisible="1"/>
                            <field name="preview_data" widget="text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_olap_dashboard_tree" model="ir.ui.view">
        <field name="name">olap.dashboard.tree</field>
        <field name="model">olap.dashboard</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="chart_type"/>
                <field name="state"/>
                <field name="sort_order"/>
            </tree>
        </field>
    </record>

    <record id="action_olap_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard Builder</field>
        <field name="res_model">olap.dashboard</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
