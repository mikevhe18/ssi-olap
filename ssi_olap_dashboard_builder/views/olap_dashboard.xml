<odoo>

    <record id="olap_dashboard_view_search" model="ir.ui.view">
        <field name="name">olap_dashboard - search</field>
        <field name="model">olap_dashboard</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <field name="name" position="after">
                    <field name="chart_type" />
                </field>
                <group name="dom_active" position="after">
                    <group name="dom_state">
                        <filter
                            name="dom_draft"
                            string="Draft"
                            domain="[('state', '=', 'draft')]"
                        />
                        <filter
                            name="dom_validated"
                            string="Validated"
                            domain="[('state', '=', 'validated')]"
                        />
                        <filter
                            name="dom_published"
                            string="Published"
                            domain="[('state', '=', 'published')]"
                        />
                    </group>
                    <group name="group_by" string="Group By">
                        <filter
                            name="group_by_state"
                            string="Status"
                            context="{'group_by': 'state'}"
                        />
                        <filter
                            name="group_by_chart_type"
                            string="Chart Type"
                            context="{'group_by': 'chart_type'}"
                        />
                    </group>
                </group>
            </data>
        </field>
    </record>

    <record id="olap_dashboard_view_tree" model="ir.ui.view">
        <field name="name">olap_dashboard - tree</field>
        <field name="model">olap_dashboard</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <field name="name" position="after">
                    <field name="chart_type" />
                    <field name="state" />
                    <field name="sort_order" />
                </field>
            </data>
        </field>
    </record>

    <record id="olap_dashboard_view_form" model="ir.ui.view">
        <field name="name">olap_dashboard - form</field>
        <field name="model">olap_dashboard</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//header" position="inside">
                    <button
                        name="action_load_schema"
                        type="object"
                        string="Lihat Struktur Tabel"
                        attrs="{'invisible': [('is_parent_menu', '=', True)]}"
                    />
                    <button
                        name="action_validate"
                        type="object"
                        string="Validate &amp; Preview"
                        class="oe_highlight"
                        attrs="{'invisible': ['|', ('is_parent_menu', '=', True), ('state', '!=', 'draft')]}"
                    />
                    <button
                        name="action_publish"
                        type="object"
                        string="Publish to Dashboard"
                        class="oe_highlight"
                        attrs="{'invisible': ['|', ('state', '=', 'published'), '&amp;', ('is_parent_menu', '=', False), ('state', '!=', 'validated')]}"
                    />
                    <button
                        name="action_update"
                        type="object"
                        string="Update"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', 'published')]}"
                    />
                    <button
                        name="action_unpublish"
                        type="object"
                        string="Unpublish"
                        confirm="Are you sure you want to unpublish? The report will disappear from the dashboard sidebar."
                        attrs="{'invisible': [('state', '!=', 'published')]}"
                    />
                    <button
                        name="action_open_dashboard"
                        type="object"
                        string="Open Dashboard"
                        attrs="{'invisible': ['|', ('state', '!=', 'published'), ('is_parent_menu', '=', True)]}"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,validated,published"
                    />
                </xpath>
                <group name="group_1" position="after">
                    <group name="group_dashboard">
                        <group>
                            <field name="is_parent_menu" />
                            <field
                                name="parent_menu_id"
                                attrs="{'invisible': [('is_parent_menu', '=', True)]}"
                            />
                            <field
                                name="chart_type"
                                attrs="{'invisible': [('is_parent_menu', '=', True)]}"
                            />
                            <field name="sort_order" />
                        </group>
                        <group>
                            <field
                                name="go_report_id"
                                readonly="1"
                                attrs="{'invisible': [('go_report_id', '=', False)]}"
                            />
                            <field name="created_by" readonly="1" />
                        </group>
                    </group>
                </group>
                <page name="note" position="before">
                    <page
                        name="schema_reference"
                        string="Referensi Tabel"
                        attrs="{'invisible': [('is_parent_menu', '=', True)]}"
                    >
                        <p class="text-muted">
                            Klik <strong>Lihat Struktur Tabel</strong> di atas
                            untuk memuat daftar tabel &amp; kolom ClickHouse
                            (odoo_analytics) yang bisa dipakai di ClickHouse
                            Query — diambil langsung dari server (bukan
                            dokumentasi statis, jadi selalu sesuai kondisi
                            terkini).
                        </p>
                        <field
                            name="schema_reference"
                            widget="text"
                            readonly="1"
                            placeholder="Belum dimuat — klik 'Lihat Struktur Tabel'."
                        />
                    </page>
                    <page
                        name="query"
                        string="Query"
                        attrs="{'invisible': [('is_parent_menu', '=', True)]}"
                    >
                        <field
                            name="ch_query"
                            widget="text"
                            placeholder="SELECT ... FROM odoo_analytics.xxx"
                        />
                    </page>
                    <page
                        name="chart_configuration"
                        string="Chart Configuration"
                        attrs="{'invisible': ['|', ('is_parent_menu', '=', True), ('chart_type', '=', 'table')]}"
                    >
                        <group>
                            <group attrs="{'invisible': [('chart_type', '=', 'kpi')]}">
                                <field name="x_axis" />
                                <field name="x_label" />
                            </group>
                            <group>
                                <field name="y_axis" />
                                <field name="y_label" />
                            </group>
                        </group>
                    </page>
                    <page
                        name="filters"
                        string="Filters"
                        attrs="{'invisible': [('is_parent_menu', '=', True)]}"
                    >
                        <p class="text-muted">
                            Filter controls shown above the report's chart on
                            the Go dashboard. Each filter's Param Name must
                            match a <code>{name:Type}</code> placeholder in
                            the ClickHouse Query (e.g. name "dateFrom" for a
                            <code>{dateFrom:Date}</code> placeholder). Leave
                            empty for a report with no filters.
                        </p>
                        <field name="filter_ids">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field name="name" />
                                <field name="label" />
                                <field name="filter_type" />
                                <field name="default_value" />
                                <field
                                    name="options"
                                    attrs="{'invisible': [('filter_type', '!=', 'select')], 'required': [('filter_type', '=', 'select')]}"
                                    placeholder="value|Label (satu per baris)"
                                />
                            </tree>
                        </field>
                    </page>
                    <page
                        name="preview"
                        string="Preview"
                        attrs="{'invisible': [('preview_data', '=', False)]}"
                    >
                        <field name="preview_columns" invisible="1" />
                        <field name="preview_data" widget="text" readonly="1" />
                    </page>
                </page>
            </data>
        </field>
    </record>

    <record id="olap_dashboard_action" model="ir.actions.act_window">
        <field name="name">Dashboard Builder</field>
        <field name="res_model">olap_dashboard</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="olap_dashboard_menu"
        name="Dashboard Builder"
        parent="menu_olap_root"
        action="olap_dashboard_action"
        sequence="10"
    />

</odoo>
