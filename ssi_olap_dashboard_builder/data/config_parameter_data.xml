<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Ganti nilai-nilai ini di Settings > Technical > System Parameters
         sesuai deployment (URL Go API, URL dashboard publik, dan API key
         yang sama dengan ODOO_API_KEY di .env server Go). -->

    <record id="config_parameter_go_api_url" model="ir.config_parameter">
        <field name="key">olap.go_api_url</field>
        <field name="value">http://analytics:8090</field>
    </record>

    <record id="config_parameter_go_dashboard_url" model="ir.config_parameter">
        <field name="key">olap.go_dashboard_url</field>
        <field name="value">https://analytics.example.com</field>
    </record>

    <record id="config_parameter_go_api_key" model="ir.config_parameter">
        <field name="key">olap.go_api_key</field>
        <field name="value">GANTI_DENGAN_ODOO_API_KEY</field>
    </record>

</odoo>
